{
  "name": "readmd-product-showcase",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "materials": "node scripts/build-materials.mjs",
    "materials:images": "node scripts/build-material-images.mjs",
    "materials:audio": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-material-audio.ps1",
    "record": "node scripts/record.mjs",
    "record:native": "node scripts/record.mjs --native",
    "compact": "node scripts/compact-waits.mjs",
    "privacy": "node scripts/finish-privacy.mjs",
    "privacy:check": "node scripts/check-privacy-capture.mjs",
    "gallery": "node scripts/build-gallery.mjs && node scripts/build-home.mjs",
    "verify": "node scripts/verify.mjs",
    "preview": "node scripts/serve.mjs",
    "report": "node scripts/build-report.mjs",
    "promo": "node scripts/build-promo.mjs",
    "cleanup": "node scripts/cleanup-runtime.mjs"
  }
}
